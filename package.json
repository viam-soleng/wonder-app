{
  "name": "wonder-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:viam": "concurrently \"vite --port 5173\" \"viam module local-app-testing --app-url http://localhost:5173/ --machine-id $VIAM_MACHINE_ID\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.1.38",
    "@viamrobotics/sdk": "^0.74.2",
    "@viamrobotics/svelte-sdk": "^1.2.3",
    "js-cookie": "^3.0.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/js-cookie": "^3.0.6",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "packageManager": "pnpm@10.33.0"
}
